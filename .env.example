# --- AI (required for LLM classify + digest; without it the rule-based fallback runs) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Storage (Neon Postgres). The app creates its own `csr_radar` schema. Without it: local file store in .data/ ---
DATABASE_URL=

# --- Email. First configured provider wins: SMTP (e.g. Gmail app password) → Brevo → Resend.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Brevo: API key + a verified sender, e.g. "CSR Radar <you@gmail.com>"
BREVO_API_KEY=
BREVO_SENDER=
# --- Email (Resend; sandbox sender only reaches the account owner). Without it the digest is stored and shown on the dashboard only ---
RESEND_API_KEY=
DIGEST_FROM_EMAIL="CSR Radar <onboarding@resend.dev>"
DIGEST_TO_EMAILS=ananya@example.org

# --- Security ---
CRON_SECRET=
ADMIN_TOKEN=

# --- Public base URL used in email links (defaults to VERCEL_PROJECT_PRODUCTION_URL) ---
APP_BASE_URL=

# --- Demo: also load seed/sample_articles.json (tagged DEMO, never in production digests) ---
DEMO_MODE=false

# --- Optional extra source ---
NEWSAPI_KEY=
