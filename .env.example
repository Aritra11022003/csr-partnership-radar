# --- AI (required for LLM classify + digest; without it the rule-based fallback runs) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Storage (Upstash Redis via Vercel Marketplace). Without it: local file store in .data/ ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's KV integration exposes these names instead; both are supported:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Email (Resend). Without it the digest is stored and shown on the dashboard only ---
RESEND_API_KEY=
DIGEST_FROM_EMAIL="CSR Radar <onboarding@resend.dev>"
DIGEST_TO_EMAILS=ananya@example.org

# --- Security ---
CRON_SECRET=
ADMIN_TOKEN=

# --- Public base URL used in email links (defaults to VERCEL_PROJECT_PRODUCTION_URL) ---
APP_BASE_URL=

# --- Demo: also load seed/sample_articles.json (tagged DEMO, never in production digests) ---
DEMO_MODE=false

# --- Optional extra source ---
NEWSAPI_KEY=
